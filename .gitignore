# Python
# Exclude compiled bytecode and other Python-related files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pdb

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
env/
venv/
ENV/
env.bak/
venv.bak/
venv-prove-it/

# Flask specific
instance/
.webassets-cache
*.log
*.db
*.sqlite
*.sqlite3

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints

# dotenv
.env
.env.*

# Sphinx documentation
docs/_build/

# Pyre type checker
.pyre/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# VSCode project files
.vscode/

# macOS files
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Other system files
*.swp
*.swo
*~

# PyCharm

.idea/
.idea/*
.idea/.gitignore
.idea/inspectionProfiles/
.idea/misc.xml
.idea/modules.xml
.idea/prove-it-backend.iml
.idea/vcs.xml